{
  "name": "cch_ResolveSecret",
  "type": "Microsoft.ProcessSimple/operations/components",
  "properties": {
    "connectionReferences": {},
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "a1b2c3d4-0001-4001-8001-000000000001"
          },
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "secretRef": {
                  "title": "secretRef",
                  "type": "string",
                  "x-ms-visibility": "important",
                  "description": "SecretRef string in the form plain:<value> or kv:<vault>/<name>[?version=<v>]. Per Topic 4 SecretRef abstraction."
                }
              },
              "required": [
                "secretRef"
              ]
            }
          }
        }
      },
      "actions": {
        "Condition_IsPlain": {
          "type": "If",
          "expression": {
            "and": [
              {
                "startsWith": [
                  "@triggerBody()?['secretRef']",
                  "plain:"
                ]
              }
            ]
          },
          "actions": {
            "Compose_PlainValue": {
              "type": "Compose",
              "inputs": "@substring(triggerBody()?['secretRef'], 6)",
              "runAfter": {}
            },
            "Response_Plain": {
              "type": "Response",
              "kind": "PowerApp",
              "inputs": {
                "statusCode": 200,
                "body": {
                  "resolvedValue": "@{outputs('Compose_PlainValue')}"
                }
              },
              "runAfter": {
                "Compose_PlainValue": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {
              "Condition_IsKv": {
                "type": "If",
                "expression": {
                  "and": [
                    {
                      "startsWith": [
                        "@triggerBody()?['secretRef']",
                        "kv:"
                      ]
                    }
                  ]
                },
                "actions": {
                  "Compose_KvRef": {
                    "type": "Compose",
                    "inputs": "@substring(triggerBody()?['secretRef'], 3)",
                    "runAfter": {}
                  },
                  "Compose_VaultName": {
                    "type": "Compose",
                    "inputs": "@first(split(outputs('Compose_KvRef'), '/'))",
                    "runAfter": {
                      "Compose_KvRef": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Compose_RawSecretPath": {
                    "type": "Compose",
                    "inputs": "@substring(outputs('Compose_KvRef'), add(indexOf(outputs('Compose_KvRef'), '/'), 1))",
                    "runAfter": {
                      "Compose_KvRef": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Compose_SecretName": {
                    "type": "Compose",
                    "inputs": "@if(contains(outputs('Compose_RawSecretPath'), '?'), first(split(outputs('Compose_RawSecretPath'), '?')), outputs('Compose_RawSecretPath'))",
                    "runAfter": {
                      "Compose_RawSecretPath": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Compose_KvVersion": {
                    "type": "Compose",
                    "inputs": "@if(contains(outputs('Compose_RawSecretPath'), '?version='), last(split(outputs('Compose_RawSecretPath'), '?version=')), '')",
                    "runAfter": {
                      "Compose_RawSecretPath": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Compose_KvUri": {
                    "type": "Compose",
                    "inputs": "@if(equals(outputs('Compose_KvVersion'), ''), concat('https://', outputs('Compose_VaultName'), '.vault.azure.net/secrets/', outputs('Compose_SecretName'), '?api-version=7.4'), concat('https://', outputs('Compose_VaultName'), '.vault.azure.net/secrets/', outputs('Compose_SecretName'), '/', outputs('Compose_KvVersion'), '?api-version=7.4'))",
                    "runAfter": {
                      "Compose_VaultName": [
                        "Succeeded"
                      ],
                      "Compose_SecretName": [
                        "Succeeded"
                      ],
                      "Compose_KvVersion": [
                        "Succeeded"
                      ]
                    }
                  },
                  "HTTP_GetKvSecret": {
                    "type": "Http",
                    "inputs": {
                      "method": "GET",
                      "uri": "@{outputs('Compose_KvUri')}",
                      "authentication": {
                        "type": "ManagedServiceIdentity",
                        "audience": "https://vault.azure.net"
                      }
                    },
                    "runAfter": {
                      "Compose_KvUri": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Response_Kv": {
                    "type": "Response",
                    "kind": "PowerApp",
                    "inputs": {
                      "statusCode": 200,
                      "body": {
                        "resolvedValue": "@{body('HTTP_GetKvSecret')?['value']}"
                      }
                    },
                    "runAfter": {
                      "HTTP_GetKvSecret": [
                        "Succeeded"
                      ]
                    }
                  }
                },
                "else": {
                  "actions": {
                    "Terminate_InvalidFormat": {
                      "type": "Terminate",
                      "inputs": {
                        "runStatus": "Failed",
                        "runError": {
                          "code": "validation_failed",
                          "message": "@{concat('cch_ResolveSecret: invalid reference format. Expected plain:<value> or kv:<vault>/<name>[?version=<v>]. Got: ', triggerBody()?['secretRef'])}"
                        }
                      },
                      "runAfter": {}
                    }
                  }
                },
                "runAfter": {}
              }
            }
          },
          "runAfter": {}
        }
      },
      "outputs": {}
    }
  }
}
