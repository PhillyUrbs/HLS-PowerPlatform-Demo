{
  "name": "continuum-portal",
  "private": true,
  "version": "0.1.0",
  "description": "Power Pages Code Site — Contoso Continuum Health (Medtech CGM demo)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:a11y": "vitest run --reporter=verbose src/components/__tests__"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.2",
    "@fluentui/react-icons": "^2.0.325",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.2",
    "axe-core": "^4.10.3",
    "jest-axe": "^10.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.6.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.0"
  }
}
