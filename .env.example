# HLS Power Platform Demo — local environment template
# Copy this file to `.env.local` and fill in real values. `.env.local` is gitignored.
#
# This file holds **build-time, operator-local** env only.
# Demo-runtime config (URLs, IDs, secrets, tunables, feature flags, brand strings)
# lives in **Dataverse Environment Variables** (see Topic 4) populated by
# `scripts/deployment-settings.json` at install time. Don't put runtime config here.

# ─── Power Platform CLI auth (build-time) ──────────────────────
# Operator's tenant for `pac auth create`.
PP_TENANT_ID=

# Target Power Platform environment URL for `pac` commands
# (e.g., https://orgxxxx.crm.dynamics.com).
PP_ENVIRONMENT_URL=

# Service principal for unattended pac/CI scenarios. Same SP that
# becomes the Dataverse Application User. Provisioned by Setup-ServicePrincipal.ps1.
PP_SP_CLIENT_ID=
PP_SP_CLIENT_SECRET=

# ─── Installer config ──────────────────────────────────────────
# Optional path override; default is scripts/deployment-settings.json.
DEPLOYMENT_SETTINGS_PATH=scripts/deployment-settings.json

# Verbosity for install.ps1 / upgrade.ps1 / doctor.ps1: info | debug | trace
LOG_LEVEL=info

# ─── Optional: synthetic data sizing (used by data/seed.ts at build time) ──
SEED_PATIENTS=50
SEED_HCPS=20
SEED_DEVICES=80
SEED_COMPLAINTS=15
